# ════════════════════════════════════════════════════════════════
# QUESTRA AI - ENVIRONMENT VARIABLES TEMPLATE
# ════════════════════════════════════════════════════════════════
# Copy this file to .env.local and fill in actual values
# IMPORTANT: Never commit .env.local to git - it's git-ignored

# ════════════════════════════════════════════════════════════════
# GOOGLE OAUTH 2.0 CONFIGURATION
# ════════════════════════════════════════════════════════════════

# Gemini AI API Key — required for AI question generation features
# Get from: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Frontend: Google Client ID (PUBLIC - safe to expose)
# Get from: https://console.cloud.google.com/
VITE_REACT_APP_GOOGLE_CLIENT_ID=462752093792-7qe3v01bs6a25v8ldsttt9cenvg1mtg1.apps.googleusercontent.com

# Backend: Google OAuth Client Credentials (SECRET - never expose)
# IMPORTANT: Keep these in .env.local only, never commit to git
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET_HERE
GOOGLE_PROJECT_ID=YOUR_GOOGLE_PROJECT_ID_HERE

# OAuth Callback URLs
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:5173/auth/google/callback
BACKEND_OAUTH_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ════════════════════════════════════════════════════════════════
# JWT & SESSION CONFIGURATION
# ════════════════════════════════════════════════════════════════

JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRY=7d
REFRESH_TOKEN_SECRET=your_refresh_secret_key_change_in_production
REFRESH_TOKEN_EXPIRY=30d

# ════════════════════════════════════════════════════════════════
# BACKEND CONFIGURATION
# ════════════════════════════════════════════════════════════════

API_PORT=5000
NODE_ENV=development
VITE_BACKEND_URL=http://localhost:5000

# ════════════════════════════════════════════════════════════════
# DATABASE CONFIGURATION (Future)
# ════════════════════════════════════════════════════════════════

# DATABASE_URL=postgresql://user:password@localhost:5432/questra_ai

# ════════════════════════════════════════════════════════════════
# OPTIONAL: ADDITIONAL OAUTH PROVIDERS
# ════════════════════════════════════════════════════════════════

# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
